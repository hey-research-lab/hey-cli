{
  "name": "@hey-research-lab/cli",
  "version": "0.1.3",
  "description": "Terminal client for HEY Research Lab's public API: Robinhood Chain projects, ships, changes, evidence and unknowns, with JSON output for scripts and agents.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "homepage": "https://heyresearch.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-cli/issues"
  },
  "keywords": [
    "hey-research",
    "robinhood-chain",
    "cli",
    "api-client",
    "builders",
    "ships",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hey": "dist/cli.js",
    "hey-research": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hey-research-lab/sdk": "^0.2.0",
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
